
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Defines the Maven POM model version -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Common identity for the entire backend project -->
    <groupId>com.abhishek</groupId>
    <artifactId>volunteer-management-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <!-- 'pom' packaging means this is a parent project, not an executable service -->
    <packaging>pom</packaging>

    <name>Volunteer Management Backend</name>

    <!-- Registers all microservices managed by this parent project.
         Each directory must contain its own pom.xml -->
    <modules>
        <module>config-server</module>
        <module>user-management-service</module>
        <module>event-management-service</module>
        <module>api-gateway</module>
        <module>eureka-server</module>
    </modules>

    <!-- Central properties shared across the backend -->
    <properties>
        <!-- Java version used to compile the microservices -->
        <java.version>21</java.version>

        <!-- Central Spring Boot version -->
        <spring-boot.version>3.5.10</spring-boot.version>

        <!-- Central Spring Cloud version compatible with Spring Boot 3.5.x -->
        <spring-cloud.version>2025.0.1</spring-cloud.version>

        <!-- Java compiler target version -->
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <!-- Manages dependency versions so child modules can omit them -->
    <dependencyManagement>
        <dependencies>

            <!-- Imports the Spring Boot dependency version catalog -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Imports the Spring Cloud dependency version catalog
                 for Config Server, Eureka, and API Gateway -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>
